{
  "name": "pausa",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node scripts/seed-runner.mjs",
    "db:studio": "prisma studio",
    "test:backend": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:cleanup": "node scripts/cleanup-runner.mjs",
    "test:smoke": "node scripts/smoke-api.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "lucide-react": "^0.468.0",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "dotenv": "^18.0.9",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.4.2",
    "jiti": "^2.7.0",
    "prisma": "^7.10.1",
    "typescript": "^5.7.2"
  },
